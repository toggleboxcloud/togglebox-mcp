{
  "name": "@toggleboxcloud/togglebox-mcp",
  "version": "1.0.0",
  "description": "MCP server for managing your Togglebox account and cloud infrastructure",
  "type": "module",
  "author": "Togglebox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toggleboxcloud/togglebox-mcp.git"
  },
  "homepage": "https://github.com/toggleboxcloud/togglebox-mcp#readme",
  "bugs": {
    "url": "https://github.com/toggleboxcloud/togglebox-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "togglebox-mcp": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "togglebox",
    "opennebula",
    "cloud"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
